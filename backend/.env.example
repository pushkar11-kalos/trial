# Copy to .env and adjust as needed. Safe defaults are used if a variable is omitted.
# None of these need to be real/paid credentials -- MetraCheck runs fully in DEMO MODE.

APP_NAME=MetraCheck
ENV=development

# Postgres (used by docker-compose). For quick local backend-only dev without Docker,
# leave DATABASE_URL unset / commented to fall back to a local SQLite file.
DATABASE_URL=postgresql+psycopg2://metracheck:metracheck@postgres:5432/metracheck

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# CORS - comma separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# OCR provider: "mock" (default, no external service/binary required), "tesseract", or "gemini"
OCR_PROVIDER=mock

# Google Gemini Vision API (required when OCR_PROVIDER=gemini)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Storage
STORAGE_BACKEND=local
STORAGE_ROOT=./storage/uploads
DEMO_ASSETS_ROOT=./storage/demo_assets
MAX_UPLOAD_MB=10

# Rule engine: OCR confidence below this threshold downgrades an otherwise-passing
# finding to REVIEW rather than a silent PASS.
OCR_REVIEW_CONFIDENCE_THRESHOLD=75
